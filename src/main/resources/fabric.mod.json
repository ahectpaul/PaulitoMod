{
	"schemaVersion": 1,
	"id": "paulitomod",
	"version": "${version}",
	"name": "PaulitoMod",
	"description": "Kill feed para servidores de Minecraft.",
	"authors": [
		"Hector Paul Ahumada"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/paulitomod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"paulito.tutorialmod.net.PaulitoMod"
		],
		"client": [
			"paulito.tutorialmod.net.client.PaulitoModClient"
		]
	},
	"mixins": [
		"paulitomod.mixins.json",
		{
			"config": "paulitomod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}